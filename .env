# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
HTTPS=false

# 数据库配置 - 连接到WSL2中的PostgreSQL
# 使用实际的WSL2 IP地址
DATABASE_URL=postgresql://pwduser:pwdsa@10.168.3.165:65432/gocomicmosaic
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# JWT配置
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRES_IN=3600
JWT_REFRESH_IN=86400

# 加密配置
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_LENGTH=32
ENCRYPTION_ITERATIONS=100000

# 服务角色配置
SERVICE_ROLE=mixed
SERVICE_ID=crud-01
